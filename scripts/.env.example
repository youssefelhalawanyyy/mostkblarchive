# ==============================================================================
# One-Time Legacy Migration Script (scripts/migrate_legacy.py)
# Copy to scripts/.env and configure before running --dry-run
# ==============================================================================

FIREBASE_SERVICE_ACCOUNT_PATH=C:\archive-sync\serviceAccountKey.json
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app

# Legacy SQL Server Connection (READ-ONLY SELECT ONLY)
SQL_DRIVER={ODBC Driver 17 for SQL Server}
SQL_SERVER=localhost\SQLEXPRESS
SQL_DATABASE=LegacyArchiveDB
SQL_TRUSTED_CONNECTION=yes
SQL_USERNAME=
SQL_PASSWORD=

# Legacy .aspx Uploads Directory (READ-ONLY)
LEGACY_UPLOADS_DIR=C:\inetpub\wwwroot\ArchiveApp\Uploads

# Legacy Table & Column Mapping
LEGACY_TABLE_NAME=dbo.ArchiveDocuments
COL_ID=Id
COL_DIRECTION=Direction
COL_SADER_NUMBER=SaderNumber
COL_SADER_DATE=SaderDate
COL_WARED_NUMBER=WaredNumber
COL_WARED_DATE=WaredDate
COL_EXTERNAL_SADER_NUMBER=ExternalSaderNumber
COL_EXTERNAL_SADER_DATE=ExternalSaderDate
COL_SUBJECT=Subject
COL_ENTITY_NAME=EntityName
COL_DOCUMENT_TYPE=DocumentType
COL_FOLDER_NAME=FolderName
COL_LEGACY_NOTES=Notes
COL_PDF_FILENAME=PdfFileName

